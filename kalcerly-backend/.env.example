# App
BUN_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
APP_DOMAIN=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kalcerly

# JWT
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password
EMAIL_FROM=noreply@kalcerly.com
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email

# Blockchain
BLOCKCHAIN_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
BLOCKCHAIN_PRIVATE_KEY=your-private-key-for-backend-wallet
BLOCKCHAIN_CHAIN_ID=97
CONTRACT_FIT_TOKEN=0x...
CONTRACT_ACTIVITY_PROOF=0x...
CONTRACT_REWARD_MANAGER=0x...
CONTRACT_CHALLENGE_MANAGER=0x...

# Cloudinary 
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Verification
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
